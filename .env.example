# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (Docker Compose defaults)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/algo_trading
TIMESCALE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/market_data
REDIS_URL=redis://localhost:6379/0

# Dhan API (REQUIRED - Get from https://dhan.co/api)
# DhanHQ v2 — https://dhanhq.co/docs/v2/ (platform app credentials; clients use their own Client ID + PIN/TOTP)
DHAN_APP_ID=
DHAN_APP_SECRET=
DHAN_API_BASE=https://api.dhan.co/v2
DHAN_AUTH_BASE=https://auth.dhan.co
DHAN_WS_URL=wss://api-feed.dhan.co
DHAN_STATIC_PUBLIC_IP=
DHAN_STATIC_PUBLIC_IP_SECONDARY=
# Legacy single-account fallbacks (optional; per-client credentials preferred)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# JWT (Auto-generated by start script)
JWT_SECRET_KEY=auto-generated
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (Auto-generated by start script)
ENCRYPTION_KEY=auto-generated

# Webhook (Auto-generated by start script; admins can override in Settings → Webhooks & alerts)
WEBHOOK_SECRET=auto-generated
# Primary passcode for TradingView JSON alerts (match Pine "Webhook Passcode" input)
# AlgoMunafa primary webhook passcode (bundled Pine defaults use this value)
WEBHOOK_PASSCODE=AM_SECURE_WH_434b2265d28a862e09b6febfab4d3ecb
# Legacy Pine passcode still accepted for older TV charts
WEBHOOK_EXTRA_PASSCODES=TV_SECRET_PASSPHRASE_123
WEBHOOK_DEDUPE_SECONDS=5
TV_WEBHOOK_PATH=/webhook/tradingview
SIGNAL_COOLDOWN_SECONDS=3
MAX_SLIPPAGE_PCT=5
FIXED_ORDER_CAPITAL=10000
# Telegram: ops group + per-client chat_id on Client record
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS / hosts (set your live domain before going public; see docs/PRODUCTION_DEPLOYMENT.md)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "algo-trading-api"]
ALLOW_PUBLIC_REGISTER=false
APP_PUBLIC_URL=http://localhost:5173
# Public API base (TradingView webhooks). Live: https://api.algomunafa.com — dev: set via ngrok -SyncEnv
API_PUBLIC_URL=http://localhost:8000
# Frontend production build: frontend/.env.production.example (VITE_API_BASE_URL, VITE_WS_URL)
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Cloudflare Zero Trust -> Networks -> Tunnels -> algomunafa-api -> Install connector -> token
# Host route (Windows connector): HTTP http://127.0.0.1:8000
# Host route (Docker connector):  HTTP http://api:8000
CLOUDFLARE_TUNNEL_TOKEN=
# Setup: .\scripts\cloudflare-tunnel.ps1 -Setup
# Start:  .\scripts\cloudflare-tunnel.ps1 -Start   OR   -Docker
# Test:   .\scripts\cloudflare-tunnel.ps1 -Verify
#
# ngrok (no domain): .\scripts\ngrok-tunnel.cmd -Auto
# One-time: NGROK_AUTHTOKEN from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
METRICS_PUBLIC=false

# Paper Trading
PAPER_TRADING_ENABLED=true
PAPER_TRADING_INITIAL_CAPITAL=1000000

# Compliance (SEBI / static IP egress)
COMPLIANCE_EGRESS_CHECK_ENABLED=true
COMPLIANCE_EGRESS_CHECK_STRICT=false
COMPLIANCE_EGRESS_CACHE_SECONDS=300
LEGAL_PACK_VERSION=2026-09-3

# Docs: https://smartapi.angelone.in/docs/Introduction
# Development-only fallback when a client connection has no per-client API key (production live orders require per-client keys).
ANGEL_API_KEY=
ANGEL_STATIC_PUBLIC_IP=
ANGEL_STATIC_PUBLIC_IP_SECONDARY=
ANGEL_CLIENT_LOCAL_IP=127.0.0.1
ANGEL_MAC_ADDRESS=00:00:5E:00:53:01
ANGEL_API_BASE_URL=https://apiconnect.angelone.in
ANGEL_WS_URL=wss://smartapisocket.angelone.in
ANGEL_LOGIN_STATE=algo_trading

# Celery (optional — run worker for durable TradingView webhook processing)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
WEBHOOK_USE_CELERY=true

# Sentry (optional)
SENTRY_DSN=

# Google Sign-In (OAuth 2.0 Web client ID)
GOOGLE_CLIENT_ID=