# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (Docker Compose defaults)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/algo_trading
TIMESCALE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/market_data
REDIS_URL=redis://localhost:6379/0

# Dhan API (REQUIRED - Get from https://dhan.co/api)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token
DHAN_API_BASE=https://api.dhan.co
DHAN_WS_URL=wss://api-feed.dhan.co

# JWT (Auto-generated by start script)
JWT_SECRET_KEY=auto-generated
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (Auto-generated by start script)
ENCRYPTION_KEY=auto-generated

# Webhook (Auto-generated by start script)
WEBHOOK_SECRET=auto-generated
TV_WEBHOOK_PATH=/webhook/tradingview

# CORS
CORS_ORIGINS=["https://app.algomunafa.com", "http://localhost:5173", "http://localhost:5174", "http://localhost:5175", "http://127.0.0.1:5173", "http://127.0.0.1:5174", "http://127.0.0.1:5175"]

# Paper Trading
PAPER_TRADING_ENABLED=true
PAPER_TRADING_INITIAL_CAPITAL=1000000

# Celery (optional)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Sentry (optional)
SENTRY_DSN=

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=197078751174-i9pe053cm2bvvvardo1q5pmpn2vb6462.apps.googleusercontent.com

