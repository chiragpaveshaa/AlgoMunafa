# Copy to .env.production — never commit real secrets.

ENVIRONMENT=production
LOG_LEVEL=INFO

# Compose-managed DB passwords (also used in DATABASE_URL inside docker-compose.prod.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=algo_trading
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=change-me-strong
TIMESCALE_DB=market_data

# App URLs (public)
APP_PUBLIC_URL=https://app.YOUR_DOMAIN
API_PUBLIC_URL=https://api.YOUR_DOMAIN
CORS_ORIGINS=["https://app.YOUR_DOMAIN","https://www.YOUR_DOMAIN"]
ALLOWED_HOSTS=["api.YOUR_DOMAIN","app.YOUR_DOMAIN"]
ALLOW_PUBLIC_REGISTER=false
METRICS_PUBLIC=false

# JWT / encryption — generate once; persist keys volume at /app/keys
JWT_SECRET_KEY=replace-with-long-random-string
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=replace-with-fernet-key

# Webhooks (TradingView)
WEBHOOK_SECRET=replace-with-random-secret
WEBHOOK_PASSCODE=replace-with-tv-passcode
WEBHOOK_EXTRA_PASSCODES=
WEBHOOK_DEDUPE_SECONDS=5
TV_WEBHOOK_PATH=/webhook/tradingview
WEBHOOK_USE_CELERY=true
SIGNAL_COOLDOWN_SECONDS=3

# Paper trading (keep LIVE off until broker UAT complete)
PAPER_TRADING_ENABLED=true
PAPER_TRADING_INITIAL_CAPITAL=1000000

# Broker platform credentials (server-only)
DHAN_APP_ID=
DHAN_APP_SECRET=
ANGEL_API_KEY=

# Google Sign-In (browser + server)
GOOGLE_CLIENT_ID=

# Optional monitoring
SENTRY_DSN=

# Compliance
COMPLIANCE_EGRESS_CHECK_ENABLED=true
COMPLIANCE_EGRESS_CHECK_STRICT=false
LEGAL_PACK_VERSION=2026-09-3
